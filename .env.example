# Cổng HTTP của nginx (người dùng vào đây). Máy cá nhân chạy thử có thể đặt 8080.
HTTP_PORT=80
# Cổng HTTPS của nginx (chỉ dùng khi bật docker-compose.https.yml)
HTTPS_PORT=443
# Tên miền của máy chủ (server_name và đường dẫn chứng chỉ). Chưa có tên miền thì để _ ; scripts/https-init.sh tự ghi dòng này.
SERVER_NAME=_
# Cổng của app, CHỈ gắn vào loopback 127.0.0.1 của máy chủ để chẩn đoán (curl http://127.0.0.1:8080/api/health)
APP_PORT=8080
# Nguồn dữ liệu ban đầu (đường dẫn TRONG container). Để trống = dùng bộ seed đi kèm image (server/seed/data)
SEED_PATH=
# Tài khoản quản trị tạo ở lần chạy đầu (chỉ khi chưa có tài khoản nào). Nên đổi mật khẩu ngay sau khi đăng nhập.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123
# Khoá ký phiên đăng nhập (để trống = tự sinh và lưu trong CSDL, phiên giữ nguyên khi khởi động lại)
JWT_SECRET=
# Số ngày hiệu lực của phiên đăng nhập (mặc định 7)
# SESSION_DAYS=7
# Tin X-Forwarded-* từ nginx (mặc định 1 vì app luôn đứng sau nginx; cờ Secure của cookie phụ thuộc vào đây)
TRUST_PROXY=1

# Cổng truy cập ứng dụng trên máy chủ
APP_PORT=8080
# File sao lưu JSON của app gốc dùng để nạp dữ liệu lần đầu
SEED_FILE=./SaoLuu_ToanBo_20261113_1537.json
# Tài khoản quản trị tạo ở lần chạy đầu (chỉ khi chưa có tài khoản nào). Nên đổi mật khẩu ngay sau khi đăng nhập.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123
# Khoá ký phiên đăng nhập (để trống = tự sinh và lưu trong CSDL, phiên giữ nguyên khi khởi động lại)
JWT_SECRET=
# Số ngày hiệu lực của phiên đăng nhập (mặc định 7)
# SESSION_DAYS=7
# Đặt 1 khi chạy sau reverse proxy HTTPS
TRUST_PROXY=
